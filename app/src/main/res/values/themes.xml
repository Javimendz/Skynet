<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.GYMCrush" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/accent_purple</item>

        <!-- Tonal Button attributes -->
        <item name="colorSecondaryContainer">@color/accent_purple_light</item>
        <item name="colorOnSecondaryContainer">@color/accent_purple</item>
        <item name="colorContainerUnchecked">@android:color/transparent</item>

        <item name="android:statusBarColor">@color/bar_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bar_dark</item>

        <!-- AppCompat compatibility attributes -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Theme specifying white background for standalone light screens like RegistroSalud -->
    <style name="Theme.GYMCrush.Light" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/accent_purple</item>
    </style>

    <!-- Estilo personalizado para el Calendario (DatePicker) -->
    <style name="CustomDatePickerTheme" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorPrimary">#000000</item> <!-- Azul oscuro de la cabecera de la app -->
        <item name="colorPrimaryDark">#020000</item>
        <item name="colorAccent">#2196F3</item> <!-- Acento rosa neón para selección y botones -->

        <!-- Fondo sólido del diálogo -->
        <item name="android:windowBackground">@drawable/bg_gradient_to_black</item>

        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <!-- Colores de texto -->
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B0FFFFFF</item>
        <item name="android:textColorPrimaryInverse">#FFFFFF</item>

        <!-- Quitar efecto translúcido -->
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:background">#1A2238</item>

        <item name="shapeAppearanceMediumComponent">@style/DialogRoundedCorner</item>
    </style>

    <style name="DialogRoundedCorner" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="MaterialAlertDialog_Rounded" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/DialogRoundedCorner</item>
    </style>

    <style name="CustomAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/DialogRoundedCorner</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_skynet_s_hollow</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.GYMCrush</item>

        <!-- AppCompat compatibility attributes for the starting theme -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.GYMCrush" parent="Base.Theme.GYMCrush" />

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="Widget.App.Button.Pill" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="CustomDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="ShapeAppearance.App.CircleComponent" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="CircleImage" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedImage" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.App.RoundedSquare" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ModernMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ModernMenuText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WhiteTextSearchView" parent="Widget.AppCompat.SearchView">
        <item name="android:textColorPrimary">#CCCCCC</item>
        <item name="android:editTextColor">#CCCCCC</item>
        <item name="android:textColorHint">#999999</item>
        <item name="colorControlNormal">#CCCCCC</item>
    </style>
    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/white</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipStrokeColor">@color/divider</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <style name="Widget.App.Chip.Selected" parent="Widget.App.Chip">
        <item name="chipBackgroundColor">@color/accent_purple</item>
        <item name="android:textColor">@color/white</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>
</resources>