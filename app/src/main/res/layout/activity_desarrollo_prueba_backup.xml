<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_light"
    tools:context=".ui.main.DesarrolloActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/nike_white">

        <!-- HEADER ESTILO NTC -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvSaludo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUENAS TARDES"
                android:textColor="@color/nike_black"
                android:textSize="24sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/tvSaludoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lunes, 22 Mayo"
                android:textColor="@color/text_secondary_light"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSaludo"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profile_image"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:src="@drawable/logo"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvSaludo"
                app:layout_constraintBottom_toBottomOf="@id/tvSaludoLabel"/>

            <ImageView
                android:id="@+id/btnMenuLateral"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_menu"
                android:layout_marginEnd="16dp"
                app:tint="@color/nike_black"
                app:layout_constraintEnd_toStartOf="@id/profile_image"
                app:layout_constraintTop_toTopOf="@id/profile_image"
                app:layout_constraintBottom_toBottomOf="@id/profile_image"/>

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/btnNotificationsAnim"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="16dp"
                app:lottie_rawRes="@raw/notification_bell"
                app:layout_constraintEnd_toStartOf="@id/btnMenuLateral"
                app:layout_constraintTop_toTopOf="@id/btnMenuLateral"
                app:layout_constraintBottom_toBottomOf="@id/btnMenuLateral"/>

            <TextView
                android:id="@+id/notificationBadge"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_circle_neon"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="@id/btnNotificationsAnim"
                app:layout_constraintEnd_toEndOf="@id/btnNotificationsAnim" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintBottom_toTopOf="@id/bottomNavContainer" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/home_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintBottom_toTopOf="@id/bottomNavContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- SEARCH BAR NTC STYLE -->
                <LinearLayout
                    android:id="@+id/search_bar_container"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_nike_search"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="24dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="@color/text_secondary_light" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Buscar entrenamientos, planes..."
                        android:textColor="@color/text_secondary_light"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- HERO SECTION: ENTRENAMIENTO DESTACADO -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="32dp">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/bg_login_modern"/>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_gradient_black_transparent"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:orientation="vertical"
                            android:padding="24dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NUEVA COLECCIÓN"
                                android:textColor="@color/nike_white"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.1"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ENTRENAMIENTO DE\nCUERPO COMPLETO"
                                android:textColor="@color/nike_white"
                                android:textSize="28sp"
                                android:fontFamily="sans-serif-black"
                                android:textStyle="bold"
                                android:lineHeight="32sp"
                                android:layout_marginTop="4dp"/>
                            <com.google.android.material.button.MaterialButton
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="EMPEZAR AHORA"
                                android:textColor="@color/nike_black"
                                app:backgroundTint="@color/nike_white"
                                app:cornerRadius="24dp"
                                android:layout_marginTop="16dp"
                                android:fontFamily="sans-serif-medium"/>
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 1. NOTICIAS IA (Simplificadas) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="32dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONSEJOS PARA TI"
                        android:textColor="@color/nike_black"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"/>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardIANews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/nike_gray">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:id="@+id/tvIANewsTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Optimización"
                                android:textColor="@color/nike_accent"
                                android:textSize="13sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:id="@+id/tvIANewsContent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Tu recuperación ha sido excelente. Hoy es un buen día para aumentar la intensidad."
                                android:textColor="@color/nike_black"
                                android:textSize="14sp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- 2. WIDGET DE NUTRICIÓN (Minimalista NTC) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="32dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TU NUTRICIÓN"
                        android:textColor="@color/nike_black"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"/>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardNutricionWidget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="0dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/nike_gray">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:id="@+id/tvNombrePlanWidget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PLAN ACTUAL" android:textColor="@color/text_secondary_light" android:textSize="12sp" android:fontFamily="sans-serif-black"/>
                                    <TextView android:id="@+id/tvCaloriasWidget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1,240 / 2,000 kcal" android:textColor="@color/nike_black" android:textSize="20sp" android:fontFamily="sans-serif-black"/>
                                </LinearLayout>
                                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_dieta" app:tint="@color/nike_black"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
                                <com.google.android.material.progressindicator.LinearProgressIndicator
                                    android:id="@+id/progressProt" android:layout_width="match_parent" android:layout_height="wrap_content" app:trackColor="@color/nike_gray" app:indicatorColor="@color/nike_black" app:trackThickness="4dp" android:progress="60" android:layout_marginBottom="8dp"/>
                                <TextView android:id="@+id/tvProtLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Proteína: 120/180g" android:textColor="@color/text_secondary_light" android:textSize="11sp" android:layout_marginBottom="12dp"/>

                                <com.google.android.material.progressindicator.LinearProgressIndicator
                                    android:id="@+id/progressCarb" android:layout_width="match_parent" android:layout_height="wrap_content" app:trackColor="@color/nike_gray" app:indicatorColor="@color/nike_black" app:trackThickness="4dp" android:progress="40" android:layout_marginBottom="8dp"/>
                                <TextView android:id="@+id/tvCarbLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Carbohidratos: 150/250g" android:textColor="@color/text_secondary_light" android:textSize="11sp" android:layout_marginBottom="12dp"/>

                                <com.google.android.material.progressindicator.LinearProgressIndicator
                                    android:id="@+id/progressGras" android:layout_width="match_parent" android:layout_height="wrap_content" app:trackColor="@color/nike_gray" app:indicatorColor="@color/nike_black" app:trackThickness="4dp" android:progress="30" android:layout_marginBottom="8dp"/>
                                <TextView android:id="@+id/tvGrasLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Grasas: 50/70g" android:textColor="@color/text_secondary_light" android:textSize="11sp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- 3. CARRUSEL DE RECETAS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECETAS DESTACADAS"
                    android:textColor="@color/nike_black"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-black"
                    android:textStyle="bold"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="16dp"/>

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerCarousel"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginBottom="32dp" />

                <!-- 4. CATEGORÍAS Y EJERCICIOS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BIBLIOTECA"
                    android:textColor="@color/nike_black"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-black"
                    android:textStyle="bold"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="16dp"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingHorizontal="20dp"
                    android:clipToPadding="false">
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupCategories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">
                        <!-- Chips sutiles estilo Nike -->
                        <com.google.android.material.chip.Chip android:id="@+id/chipAll" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Todos" android:checked="true" app:chipBackgroundColor="@color/nike_gray" app:chipStrokeWidth="0dp"/>
                        <com.google.android.material.chip.Chip android:id="@+id/chipFuerza" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fuerza" app:chipBackgroundColor="@color/nike_gray" app:chipStrokeWidth="0dp"/>
                        <com.google.android.material.chip.Chip android:id="@+id/chipCardio" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cardio" app:chipBackgroundColor="@color/nike_gray" app:chipStrokeWidth="0dp"/>
                        <com.google.android.material.chip.Chip android:id="@+id/chipHipertrofia" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yoga" app:chipBackgroundColor="@color/nike_gray" app:chipStrokeWidth="0dp"/>
                        <com.google.android.material.chip.Chip android:id="@+id/chipResistencia" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Resistencia" app:chipBackgroundColor="@color/nike_gray" app:chipStrokeWidth="0dp"/>
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerExerciseCarousel"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="32dp" />

                <!-- 5. RENDIMIENTO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="32dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TU ACTIVIDAD"
                        android:textColor="@color/nike_black"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="0dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/nike_gray">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="20dp"
                            android:gravity="center_vertical">
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progressCircularStat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:indicatorSize="64dp"
                                app:trackThickness="4dp"
                                app:trackColor="@color/nike_gray"
                                app:indicatorColor="@color/nike_black"
                                android:progress="75" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="20dp">
                                <TextView android:id="@+id/tvActividadPorcentaje" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="75%" android:textColor="@color/nike_black" android:textSize="24sp" android:fontFamily="sans-serif-black"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Objetivos semanales" android:textColor="@color/text_secondary_light" android:textSize="12sp"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                                <TextView android:id="@+id/tvReservasValor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="@color/nike_accent" android:textSize="24sp" android:fontFamily="sans-serif-black"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reservas" android:textColor="@color/text_secondary_light" android:textSize="12sp" android:layout_marginBottom="4dp"/>
                                <com.google.android.material.progressindicator.LinearProgressIndicator
                                    android:id="@+id/progressReservas"
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    app:trackThickness="4dp"
                                    app:trackColor="@color/nike_gray"
                                    app:indicatorColor="@color/nike_accent"
                                    android:progress="0"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="16dp">
                        <View android:id="@+id/dotL" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_circle_gray" android:layout_margin="4dp"/>
                        <View android:id="@+id/dotM" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_circle_gray" android:layout_margin="4dp"/>
                        <View android:id="@+id/dotMi" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_circle_gray" android:layout_margin="4dp"/>
                        <View android:id="@+id/dotJ" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_circle_gray" android:layout_margin="4dp"/>
                        <View android:id="@+id/dotV" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_circle_gray" android:layout_margin="4dp"/>
                        <View android:id="@+id/dotS" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_circle_gray" android:layout_margin="4dp"/>
                        <View android:id="@+id/dotD" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_circle_gray" android:layout_margin="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 6. LOCALIZACIÓN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="32dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NUESTRO CLUB"
                        android:textColor="@color/nike_black"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        app:cardCornerRadius="0dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/nike_gray">
                        <fragment
                            android:id="@+id/map"
                            android:name="com.google.android.gms.maps.SupportMapFragment"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- BOTTOM NAV NTC -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomNavContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nike_white"
            app:layout_constraintBottom_toBottomOf="parent">

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/nike_gray" app:layout_constraintTop_toTopOf="parent"/>

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/botton_nav"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@color/nike_white"
                app:itemIconTint="@color/nike_black"
                app:itemTextColor="@color/nike_black"
                app:labelVisibilityMode="unlabeled"
                app:menu="@menu/nav_menu"
                app:elevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface_white"
        app:itemTextColor="@color/text_black"
        app:itemIconTint="#BB86FC"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_desplegable" />

</androidx.drawerlayout.widget.DrawerLayout>